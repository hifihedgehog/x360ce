<UserControl
	x:Class="x360ce.App.Controls.OptionsHidHideControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:x360ce.App.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="250"
	d:DesignWidth="800"
	Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
	mc:Ignorable="d">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/x360ce.Engine;component/JocysCom/Controls/Themes/Default.xaml" />
				<ResourceDictionary Source="/x360ce.Engine;component/JocysCom/Controls/Themes/Icons.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid Margin="3,3,3,3">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<GroupBox Grid.Row="0">
			<GroupBox.Header>
				<TextBlock Text="HID Hide by Nefarius" />
			</GroupBox.Header>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" MinWidth="8" />
					<ColumnDefinition Width="*" MinWidth="8" />
					<ColumnDefinition Width="Auto" MinWidth="8" />
					<ColumnDefinition Width="Auto" MinWidth="8" />
				</Grid.ColumnDefinitions>
				<Button Name="HidHideRefreshButton" Grid.Row="0" Grid.Column="3">Refresh</Button>
				<Label Name="HidHideLabel" Grid.Row="0" Grid.Column="0">HID Hide</Label>
				<TextBox
					Name="HidHideTextBox"
					Grid.Row="0"
					Grid.Column="1"
					IsReadOnly="True" />
				<Button
					Name="HidHideUninstallButton"
					Grid.Row="0"
					Grid.Column="2"
					Content="Uninstall"
					IsEnabled="False" />
				<Button
					Name="HidHideInstallButton"
					Grid.Row="0"
					Grid.Column="3"
					Content="Install"
					IsEnabled="False" />
			</Grid>
		</GroupBox>
		<RichTextBox
			Name="HelpRichTextBox"
			Grid.Row="1"
			Background="White"
			IsReadOnly="True">
			<FlowDocument>
				<Paragraph>
					<Run />
				</Paragraph>
			</FlowDocument>
		</RichTextBox>
	</Grid>
</UserControl>
